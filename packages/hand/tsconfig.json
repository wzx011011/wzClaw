{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "tools/**/*.ts", "docker-entry.ts", "src/config/**/*.ts", "src/mcp/**/*.ts"],
  "exclude": ["**/*.test.ts", "node_modules", "dist"]
}
